# Only needed if you are NOT using Doppler. By default the app reads its
# configuration from the process environment, which `make run` gets from
# Doppler (`doppler run --`). To use a file instead:
#
#   cp .env.example .env      # then fill in real values
#   make run ENV_FILE=.env    # likewise: make migrate-up ENV_FILE=.env
#
# Values already set in the environment (e.g. by Doppler) win over this file.
# See config/env.go for how these are loaded and their fallback defaults.
#
# ENVIRONMENT is intentionally not set here. It's required (no default) and
# must be "development", "test", or "production". Make sets it to
# "development" for you when ENV_FILE is passed.

# --- Server ---
PUBLIC_HOST=http://localhost
PORT=8080

# --- CORS ---
FRONTEND_URL=http://localhost:3000
# Optional: additional allowed origin for the deployed frontend
PRODUCTION_FRONTEND_URL=

# --- Auth ---
JWT_SECRET=
JWT_EXP_IN_SEC=604800

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=brindl_dev
DB_SSL_MODE=disable

# --- Web Push (VAPID) ---
# Generate with: go run cmd/vapidgen/main.go
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@animalfamily.app

# --- Species lookup / AI ---
OPENAI_API_KEY=

# --- AWS (S3 for species/animal images) ---
S3_ASSETS_BUCKET=brindl-assets
AWS_REGION=us-east-1
